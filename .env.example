# Copie para .env e preencha. Valores abaixo são fictícios.

# --- Airflow (docker-compose.yml) ---
AIRFLOW_UID=50000
FERNET_KEY=gere-uma-chave-fernet
# Opcionais (defaults só para uso local):
# _AIRFLOW_WWW_USER_USERNAME=airflow
# _AIRFLOW_WWW_USER_PASSWORD=airflow
# AIRFLOW__API_AUTH__JWT_SECRET=troque-em-producao

# --- Databricks (DAG, Databricks CLI e dbt) ---
DATABRICKS_HOST=dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=dapi-token-ficticio
DBT_DATABRICKS_TOKEN=dapi-token-ficticio
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_CATALOG=meu_catalogo
DATABRICKS_SCHEMA=raw
DATABRICKS_VOLUME_RAW=raw

# --- Meltano / tap-digisus ---
TAP_DIGISUS_RATE_LIMIT_PER_MINUTE=50
TAP_DIGISUS_RETRY_MODE=false
# TAP_DIGISUS_MUNICIPIO_ID é definida pela DAG a cada task.
# Opcional: só se usar o loader de teste target-jsonl (ver extraction/README.md)
# TARGET_JSONL_DESTINATION_PATH=output/
